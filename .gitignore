# ═══════════════════════════════════════════════════
# NEXUS Agent — .gitignore
# ═══════════════════════════════════════════════════

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
venv/
.venv/
env/
.env

# --- Model files (large binaries — never commit) ---
model/*.gguf
model/*.bin
model/*.safetensors

# --- Training artefacts (user-specific) ---
lora-weights/
datasets/*
!datasets/README.txt

# --- Secrets & user state ---
config/user_memory.json
config/user_memory.json.bak
config/permissions.json

# --- Generated indexes & runtime state ---
rag-index/
tasks_queue.json
*.log
.cache/

# --- Internal working docs (not for the public repo) ---
docs/

# --- OS / editor cruft ---
Thumbs.db
.DS_Store
.idea/
.vscode/
